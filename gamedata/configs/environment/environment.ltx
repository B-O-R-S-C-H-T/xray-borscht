[environment]
; настройки молний
        altitude                         = 20.000000    ; высота (градусы)
        delta_longitude                  = 30.000000    ; разброс по горизонту (градусы)
        fog_color                        = 0.100000     ; добавочный коэфф. к цвету тумана
        min_dist_factor                  = 0.940000     ; (<0.95) расстояние от FAR_PLANE
        second_propability               = 0.820000     ; вероятность появления следующей молнии после этой
        sky_color                        = 0.100000     ; добавочный коэфф. к цвету неба
        sun_color                        = 0.900000     ; добавочный коэфф. к цвету солнца
        tilt                             = 19.000000    ; отклонение молнии от оси (15-30 градусов)
; настройки солнца
        dynamic_sun                      = on           ; если включено, то движение солнца рассчитывается движком автоматически; иначе берутся координаты из конфига погоды
        physically_accurate_sun          = on           ; если включено, то движение солнца рассчитывает библиотека небесной механики libnova; иначе используется родная функция расчёта
